FROM python@sha256:ec948fa5f90f4f8907e89f4800cfd2d2e91e391a4bce4a6afa77ba265bc3a2fe
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY deploy/requirements-ocr.txt requirements-grpc.txt
RUN pip install --no-cache-dir paddlepaddle-gpu==3.2.2 -i https://www.paddlepaddle.org.cn/packages/stable/cu126/
RUN pip install --no-cache-dir -r requirements-grpc.txt
COPY packages/protocol /tmp/protocol
COPY packages/ocr /tmp/ocr
RUN pip install --no-cache-dir /tmp/protocol /tmp/ocr && rm -rf /tmp/protocol /tmp/ocr
ENV SERVICE=ocr PADDLE_PDX_CACHE_HOME=/cache/paddlex HF_HOME=/cache/huggingface PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True OMP_NUM_THREADS=2 PYTHONUNBUFFERED=1
CMD ["python", "-m", "ngn_fba_ocr.service"]
