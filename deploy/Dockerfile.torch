FROM python@sha256:ec948fa5f90f4f8907e89f4800cfd2d2e91e391a4bce4a6afa77ba265bc3a2fe AS torch-base
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.9.1 torchvision==0.24.1 --index-url https://download.pytorch.org/whl/cu126
RUN pip install --no-cache-dir transformers==4.57.3 pillow==12.1.0 numpy==2.2.6 opencv-python-headless==4.12.0.88
COPY packages/protocol /tmp/protocol
RUN pip install --no-cache-dir /tmp/protocol && rm -rf /tmp/protocol
ARG SERVICE
COPY packages/${SERVICE} /app/package
RUN pip install --no-cache-dir /app/package
ENV SERVICE=${SERVICE} HF_HUB_OFFLINE=1 OMP_NUM_THREADS=4 PYTHONUNBUFFERED=1
CMD ["sh", "-c", "exec python -m ngn_fba_${SERVICE}.service"]
